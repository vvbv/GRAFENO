/* GRAFENO — tema de la TUI (grafito + acento verde lima) */

Screen {
    background: #0d1117;
}

Header {
    background: #161b22;
    color: #e6edf3;
}

Footer {
    background: #161b22;
}

#subtitle {
    color: #8b949e;
    padding: 0 2;
    margin-bottom: 1;
}

#clock {
    color: #8b949e;
    padding: 0 2;
}

#tasks-header {
    height: auto;
}

#scope-toggle {
    width: auto;
    margin-right: 2;
}

/* ---- Lista de tareas ---- */
#tasks-table {
    margin: 0 2;
    border: round #30363d;
    height: 1fr;
}

#tasks-table:focus {
    border: round #7ee787;
}

#empty-hint {
    color: #8b949e;
    padding: 1 2;
}

#token-summary {
    color: #8b949e;
    padding: 0 2;
    margin-bottom: 1;
}

/* ---- Nueva tarea (modal) ---- */
#new-task-dialog {
    background: #161b22;
    border: round #7ee787;
    padding: 1 2;
    width: 70;
    height: auto;
    max-height: 100%;
    margin: 1 2;
    overflow-y: auto;
}

#new-task-title, #config-title {
    text-style: bold;
    color: #7ee787;
    margin-bottom: 1;
}

#new-task-dialog Label {
    color: #8b949e;
    margin-top: 1;
}

#new-task-dialog TextArea {
    height: 5;
    border: round #30363d;
}

#new-task-dialog .final-prompt-row {
    height: 3;
    margin: 0;
}

#new-task-dialog .final-prompt-row Label {
    width: 18;
    color: #8b949e;
    margin-top: 0;
}

#new-task-dialog .final-prompt-row TextArea {
    height: 3;
    border: round #30363d;
}

#cfg-final-prompt {
    height: 3;
    border: round #30363d;
}

#nt-buttons, #config-buttons {
    margin-top: 1;
    height: auto;
}

/* ---- Confirmación de plan (modal) ---- */
#plan-confirm-dialog {
    background: #161b22;
    border: round #e3b341;
    padding: 1 2;
    width: 64;
    height: auto;
    margin: 2 4;
}

#plan-confirm-title {
    text-style: bold;
    color: #e3b341;
    margin-bottom: 1;
}

#pc-buttons {
    margin-top: 1;
    height: auto;
}

#pc-buttons Button {
    margin-right: 2;
}

.pc-detail {
    color: #8b949e;
    margin-top: 1;
}

#nt-buttons Button, #config-buttons Button {
    margin-right: 2;
}

/* ---- Detalle de tarea ---- */
#task-title {
    padding: 0 2;
    color: #e6edf3;
}

PhaseBar {
    padding: 0 2;
    height: 3;
}

#activity-bar {
    padding: 0 2;
    height: 1;
    border-bottom: solid #30363d;
}

#tabs {
    height: 1fr;
}

TabPane {
    padding: 0;
}

TabPane Horizontal {
    height: 1fr;
}

FileList {
    width: 32;
    border-right: solid #30363d;
}

FileList:focus {
    border-right: solid #7ee787;
}

#desc-scroll, #plan-scroll, #review-scroll, #final-scroll {
    width: 1fr;
    height: 1fr;
}

Markdown {
    padding: 0 2;
}

#desc-view {
    padding: 1 2;
}

#live-log {
    padding: 0 2;
    background: #0d1117;
}

/* ---- Configuración ---- */
#config-container {
    padding: 1 3;
    overflow-y: auto;
}

.section-title {
    text-style: bold;
    color: #7ee787;
    margin-top: 1;
}

.role-row {
    height: auto;
    margin: 0;
}

.role-row .role-title {
    text-style: bold;
    color: #e6edf3;
    margin-top: 1;
}

.role-row-fields {
    height: auto;
    margin: 0;
}

.role-row .cli-select {
    width: 16;
}

.role-row .model-select {
    width: 1fr;
}

.role-row .effort-select {
    width: 22;
}

.role-row Select {
    margin: 0 1;
}

#models-status {
    color: #8b949e;
    text-style: italic;
    margin-top: 1;
}

#roles-status {
    color: #8b949e;
    text-style: italic;
    margin-top: 1;
}

.automode-row {
    height: auto;
    margin-top: 1;
}

.automode-row Label {
    color: #8b949e;
    padding: 1 1 0 2;
}

.automode-row Checkbox {
    margin-right: 4;
}

#am-max-iter {
    width: 10;
}

#am-tests {
    width: 1fr;
}
