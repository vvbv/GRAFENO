/* GRAFENO — tema de la TUI (grafito + acento verde lima) */

Screen {
    background: #0d1117;
}

Header {
    background: #161b22;
    color: #e6edf3;
}

Footer {
    background: #161b22;
}

#subtitle {
    color: #8b949e;
    padding: 0 2;
    margin-bottom: 1;
}

/* ---- Lista de tareas ---- */
#tasks-table {
    margin: 0 2;
    border: round #30363d;
    height: 1fr;
}

#tasks-table:focus {
    border: round #7ee787;
}

#empty-hint {
    color: #8b949e;
    padding: 1 2;
}

/* ---- Nueva tarea (modal) ---- */
#new-task-dialog {
    background: #161b22;
    border: round #7ee787;
    padding: 1 2;
    width: 70;
    height: auto;
    max-height: 100%;
    margin: 1 2;
    overflow-y: auto;
}

#new-task-title, #config-title {
    text-style: bold;
    color: #7ee787;
    margin-bottom: 1;
}

#new-task-dialog Label {
    color: #8b949e;
    margin-top: 1;
}

#new-task-dialog TextArea {
    height: 5;
    border: round #30363d;
}

#nt-buttons, #config-buttons {
    margin-top: 1;
    height: auto;
}

#nt-buttons Button, #config-buttons Button {
    margin-right: 2;
}

/* ---- Detalle de tarea ---- */
#task-title {
    padding: 0 2;
    color: #e6edf3;
}

PhaseBar {
    padding: 0 2;
    height: 3;
    border-bottom: solid #30363d;
}

#tabs {
    height: 1fr;
}

TabPane {
    padding: 0;
}

TabPane Horizontal {
    height: 1fr;
}

FileList {
    width: 32;
    border-right: solid #30363d;
}

FileList:focus {
    border-right: solid #7ee787;
}

Markdown {
    padding: 0 2;
    width: 1fr;
}

#live-log {
    padding: 0 2;
    background: #0d1117;
}

/* ---- Configuración ---- */
#config-container {
    padding: 1 3;
}

.section-title {
    text-style: bold;
    color: #7ee787;
    margin-top: 1;
}

.role-row {
    height: auto;
    margin: 0;
}

.role-row .role-title {
    text-style: bold;
    color: #e6edf3;
    margin-top: 1;
}

.role-row Select {
    width: 24;
}

.role-row Input {
    width: 1fr;
}

.role-row Select, .role-row Input {
    margin: 0 1;
}

.automode-row {
    height: auto;
    margin-top: 1;
}

.automode-row Label {
    color: #8b949e;
    padding: 1 1 0 2;
}

.automode-row Checkbox {
    margin-right: 4;
}

#am-max-iter {
    width: 10;
}

#am-tests {
    width: 1fr;
}
